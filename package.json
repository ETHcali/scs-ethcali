{
  "name": "ethcalifaucet",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:base": "hardhat run scripts/deploy-all.ts --network base",
    "deploy:ethereum": "hardhat run scripts/deploy-all.ts --network ethereum",
    "deploy:unichain": "hardhat run scripts/deploy-all.ts --network unichain",
    "deploy:optimism": "hardhat run scripts/deploy-all.ts --network optimism",
    "setup:frontend": "hardhat run scripts/setup-frontend.ts",
    "verify:base": "hardhat run scripts/verify-contracts.ts --network base",
    "verify:ethereum": "hardhat run scripts/verify-contracts.ts --network ethereum",
    "verify:unichain": "hardhat run scripts/verify-contracts.ts --network unichain",
    "verify:optimism": "hardhat run scripts/verify-contracts.ts --network optimism",
    "deploy:celo": "hardhat run scripts/deploy-all.ts --network celo",
    "verify:celo": "hardhat run scripts/verify-contracts.ts --network celo",
    "test:forge": "forge test --match-path 'test/forge/*'",
    "test:forge:deep": "FOUNDRY_PROFILE=deep forge test --match-path 'test/forge/*'",
    "test:all": "hardhat test && forge test --match-path 'test/forge/*'",
    "build:forge": "forge build --skip test",
    "estimate": "node scripts/estimate-deploy-cost.mjs",
    "estimate:donations": "node scripts/estimate-deploy-cost.mjs celo donations",
    "deploy:donations:celo": "hardhat run scripts/deploy-donations.ts --network celo",
    "deploy:donations:base": "hardhat run scripts/deploy-donations.ts --network base",
    "seed:swag": "hardhat run scripts/seed-swag.ts",
    "seed:swag:dry": "DRY_RUN=1 hardhat run scripts/seed-swag.ts",
    "seed:campaign:celo": "hardhat run scripts/seed-campaign.ts --network celo",
    "deploy:donations:optimism": "hardhat run scripts/deploy-donations.ts --network optimism",
    "seed:campaign:optimism": "hardhat run scripts/seed-campaign.ts --network optimism",
    "estimate:donations:optimism": "node scripts/estimate-deploy-cost.mjs optimism donations",
    "seed:campaign:base": "hardhat run scripts/seed-campaign.ts --network base",
    "estimate:donations:base": "node scripts/estimate-deploy-cost.mjs base donations",
    "deploy:donations:ethereum": "hardhat run scripts/deploy-donations.ts --network ethereum",
    "seed:campaign:ethereum": "hardhat run scripts/seed-campaign.ts --network ethereum",
    "estimate:donations:ethereum": "node scripts/estimate-deploy-cost.mjs ethereum donations",
    "launch:donations": "node scripts/launch-donations.mjs",
    "launch:donations:go": "DRY_RUN=0 node scripts/launch-donations.mjs"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.0.6",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.1",
    "@nomicfoundation/hardhat-verify": "^3.0.8",
    "@openzeppelin/contracts": "^5.4.0",
    "@types/node": "^25.0.3",
    "hardhat": "^3.1.2",
    "viem": "^2.43.5"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  }
}
