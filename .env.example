PRIVATE_KEY=your_private_key_here

# ============================================================
# ADMIN & TREASURY CONFIGURATION
# ============================================================
# These addresses are assigned as admins/owners during deployment.
# After deployment, admins can be added/removed via contract functions.
# ============================================================

# --- Contract Admins ---
SWAG_ADMIN=0xYourSwagAdminAddress
FAUCET_ADMIN=0xYourFaucetAdminAddress
ZK_PASSPORT_ADMIN=0xYourZKPassportAdminAddress

# --- Treasury ---
# Receives USDC payments from swag purchases (remainder after royalties)
SWAG_TREASURY_ADDRESS=0xYourTreasuryAddress

# --- ZK NFT Metadata (Optional - can be set after deployment) ---
NFT_IMAGE_URI=https://ipfs.io/ipfs/bafkreibbus6atvrmfigbubdymruosbaiaipumplwafvcxve7zretpuvfda
NFT_DESCRIPTION=ZKPassport Verification NFT - Proof of unique personhood for the ETHCALI ecosystem.
NFT_EXTERNAL_URL=https://ethcali.org

# --- Mainnet RPC URLs ---
# Ethereum Mainnet
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/apikey
# Base Mainnet
BASE_RPC_URL=https://base-mainnet.infura.io/v3/apikey
# Unichain Mainnet
UNICHAIN_RPC_URL=https://unichain-mainnet.infura.io/v3/apikey
# Optimism Mainnet
OPTIMISM_RPC_URL=https://optimism-mainnet.infura.io/v3/apikey
# Celo Mainnet (chainId 42220) — public RPC, no key required
CELO_RPC_URL=https://forno.celo.org

# Block Explorer API Keys (for contract verification)
ETHERSCAN_API_KEY=apikey
BASESCAN_API_KEY=apikey
UNICHAIN_API_KEY=apikey
OPTIMISM_API_KEY=apikey
CELOSCAN_API_KEY=apikey

# USDC Addresses (Network-specific, for Swag1155 deployment)
USDC_ADDRESS_ETH=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
USDC_ADDRESS_BASE=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
USDC_ADDRESS_UNI=0x078D782b760474a361dDA0AF3839290b0EF57AD6
USDC_ADDRESS_OP=0x0b2C639c533813f4Aa9D7837CAf62653d097Ff85

# NOTE: Pinata JWT & Gateway are only needed in the FRONTEND repo
# (for admin to upload images/metadata when creating products)
# They are NOT needed to deploy the contract
# ============================================================
# DONATION VAULT (earthquake relief)
# ============================================================
# ── Custody: DEFAULT_ADMIN_ROLE ──────────────────────────────────────────
# The ONLY role that can change the beneficiary or switch router/holder mode.
# Must be the multisig. The deploy script grants this then has the deployer
# renounce its own, so no single key can redirect donations.
#
# It refuses the handoff if this address has no code on the target chain — a
# smart account that is not deployed there could never sign, and the beneficiary
# would be frozen forever.
DONATION_CUSTODY_ADMIN=0xB6BDe4fB6dFBad5488Fa31Edf0F3730D9D86da64

# ── Operations: ADMIN_ROLE ───────────────────────────────────────────────
# Comma-separated. Create campaigns, set tiers, withdraw — but withdraw takes no
# destination, so these can only ever move funds TO the beneficiary.
#
# Prefer plain EOAs. Verified on-chain: the deployer 0x3B89… is an EOA and works
# on all five chains; 0x35b0… is a smart account with code only on Base and
# Unichain, so it cannot sign on Celo, Optimism or Ethereum.
DONATION_OPS_ADMINS=0x3B89Ad8CC39900778aBCdcc22bc83cAC031A415B,0x35b0c64CeDC2fD1a7298984CBa5C7E402970BC6B

# Legacy single-admin fallback, used only when DONATION_OPS_ADMINS is empty.
DONATION_ADMIN=0x3B89Ad8CC39900778aBCdcc22bc83cAC031A415B

# The ONLY address campaign funds can be withdrawn to (or routed to in router mode).
# This is ethcali.eth — a Safe v1.4.1 3-of-5 multisig, verified deployed at this
# same address on Ethereum, Base, Optimism, Celo and Unichain with identical owners.
DONATION_BENEFICIARY=0xB6BDe4fB6dFBad5488Fa31Edf0F3730D9D86da64

# Receipt NFT collection metadata
DONATION_RECEIPT_NAME=ETH Cali Relief Receipts
DONATION_RECEIPT_SYMBOL=ETHCALI-RELIEF
DONATION_RECEIPT_BASE_URI=ipfs://YourBaseCid/{id}.json

# ============================================================
# CELO TOKENS
# ============================================================
# COPm — Mento Colombian Peso, 18 decimals. Celo mainnet.
# Verified on-chain (symbol "COPm", decimals 18). Falls back to this value.
COPM_ADDRESS_CELO=0x8a567e2ae79ca692bd748ab832081c45de4041ea

# Native USDC on Celo, 6 decimals. Verified on-chain.
USDC_ADDRESS_CELO=0xcebA9300f2b948710d2653dD7B07f33A8B32118C
